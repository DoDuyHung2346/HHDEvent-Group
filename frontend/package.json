{
  "name": "eventviet-chatbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "concurrently -k -n FRONTEND,BACKEND -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev --webpack -H 0.0.0.0",
    "dev:backend": "cd .. && python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "install:backend": "python -m pip install -r ../backend/requirements.txt",
    "configure:vilao": "node scripts/configure-vilao.mjs",
    "test:backend": "python -m pytest ../backend/tests -q",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/postcss": "^4.1.18",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
