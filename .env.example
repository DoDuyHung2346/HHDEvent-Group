# EventViet local environment — copy to .env, then edit only the values marked below.
# Browser calls RAG through the Next.js proxy. Do not expose RAG hostname or
# ADMIN_TOKEN to the browser in a production deployment.
NEXT_PUBLIC_RAG_BACKEND_URL=/api/rag
RAG_BACKEND_URL=http://127.0.0.1:8000
APP_ENV=dev
ADMIN_TOKEN=eventviet-local-admin-token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL. Service role chỉ dùng tại Next.js server, không đưa vào
# biến NEXT_PUBLIC_* và không commit giá trị thật vào Git.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key dùng cho đăng ký/đăng nhập phía trình duyệt, không phải Secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep real in normal operation. Set mock only when demonstrating without AI.
AI_MODE=real

# DEFAULT: native Google Gemini for both answer generation and embedding.
# Obtain this key from Google AI Studio. It normally begins with AIza.
LLM_PROVIDER=gemini
LLM_API_KEY=
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_GEMINI_KEY_HERE
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_S=30

EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_BATCH=64

VECTOR_BACKEND=qdrant_local
QDRANT_PATH=./backend/data/qdrant
QDRANT_COLLECTION=kb_chunks
DB_URL=sqlite:///./backend/data/app.db

TOPK_DENSE=20
TOPK_BM25=20
RRF_K=60
CONTEXT_TOPK=5
DOC_TYPE_BOOST=0.15
RERANK_PROVIDER=none
RERANK_CANDIDATES=15

MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_QUERY_CHARS=500
HISTORY_TURNS=4
ENRICH=false
CHUNK_TARGET_SYLLABLES=350
CHUNK_MAX_SYLLABLES=550
CHUNK_MIN_SYLLABLES=40
CHUNK_OVERLAP_RATIO=0.12
SEED_ON_EMPTY=true
CACHE_BACKEND=memory
EXACT_CACHE_TTL_S=21600
SEMANTIC_CACHE_THRESHOLD=0.96
LOG_LEVEL=INFO
LOG_PII_MASK=true

# ALTERNATIVE: an OpenAI-compatible proxy such as Vilao for LLM only.
# A Vilao/OpenAI `sk-...` key is NOT a Gemini Embedding key.
# The Next.js fallback uses the same LLM_* variables, so do not also set
# ANTHROPIC_API_KEY / AI_BASE_URL for this profile.
# LLM_API_KEY=PASTE_PROXY_KEY_HERE
# LLM_BASE_URL=https://api.vilao.ai/v1
# LLM_MODEL=gemini-3.8-flash
# EMBED_PROVIDER=local_st
# EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBED_DIM=384
