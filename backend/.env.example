# Optional backend-only env file. Root .env is preferred for `npm run dev`.
LLM_PROVIDER=gemini
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
VECTOR_BACKEND=qdrant_local
QDRANT_PATH=./backend/data/qdrant
DB_URL=sqlite:///./backend/data/app.db
ADMIN_TOKEN=eventviet-local-admin-token
