# Chế độ demo tự chạy bằng Docker, không cần API key bên thứ ba.
# Dùng file này để kiểm tra upload/index tài liệu RAG sau khi clone repository.
# Câu trả lời AI trong chế độ này là mock; không dùng cho môi trường thực tế.
NEXT_PUBLIC_RAG_BACKEND_URL=/api/rag
RAG_BACKEND_URL=http://127.0.0.1:8000
APP_ENV=dev
ADMIN_TOKEN=eventviet-demo-admin-token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Để trống nếu chỉ thử RAG upload. Muốn đăng nhập/đặt lịch thật, dùng .env.example
# và điền thông tin Supabase của dự án riêng.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_MODE=mock
LLM_PROVIDER=fake
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=fake
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_S=30

# Fake embedding giúp upload/index hoạt động offline. Nó chỉ phù hợp để demo luồng,
# không dùng để đánh giá chất lượng tìm kiếm ngữ nghĩa.
EMBED_PROVIDER=fake
EMBED_MODEL=fake-hash-768
EMBED_DIM=768
EMBED_BATCH=64

VECTOR_BACKEND=qdrant_local
QDRANT_PATH=./backend/data/qdrant
QDRANT_COLLECTION=kb_chunks
DB_URL=sqlite:///./backend/data/app.db

TOPK_DENSE=20
TOPK_BM25=20
RRF_K=60
CONTEXT_TOPK=5
DOC_TYPE_BOOST=0.15
RERANK_PROVIDER=none
RERANK_CANDIDATES=15

MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_QUERY_CHARS=500
HISTORY_TURNS=4
ENRICH=false
CHUNK_TARGET_SYLLABLES=350
CHUNK_MAX_SYLLABLES=550
CHUNK_MIN_SYLLABLES=40
CHUNK_OVERLAP_RATIO=0.12
SEED_ON_EMPTY=true
CACHE_BACKEND=memory
EXACT_CACHE_TTL_S=21600
SEMANTIC_CACHE_THRESHOLD=0.96
LOG_LEVEL=INFO
LOG_PII_MASK=true
